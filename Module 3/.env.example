# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/inkwell
# MongoDB Atlas:    mongodb+srv://<user>:<password>@<cluster-url>/inkwell?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/inkwell

# Secret used to sign JWTs. Use a long, random string in production.
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
